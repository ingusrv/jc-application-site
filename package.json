    "@types/node": "^22.13.4",
    "bits-ui": "^2.19.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "shadcn-svelte": "^1.5.1",
    "svelte": "^5.20.2",
    "svelte-adapter-azure-swa": "^0.22.1",
    "svelte-check": "^4.1.4",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.0.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
